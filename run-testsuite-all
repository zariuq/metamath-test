#!/bin/bash
# Run ALL Metamath tests with any driver.
# Usage: ./run-testsuite-all <driver> [--skip-large]
#
# Examples:
#   ./run-testsuite-all ./test-pverify --skip-large
#   ./run-testsuite-all ./test-metamath-knife
#   ./run-testsuite-all ./mmexe.sh
#
# Tests and expected verdicts are HARDCODED below from SPEC_SECTION_4.txt analysis.
# This is the authoritative reference - edit HERE to change expectations.

if [ $# -lt 1 ]; then
    echo "Usage: $0 <driver> [--skip-large]"
    echo "Drivers: ./test-pverify, ./test-metamath-knife, ./mmexe.sh, etc."
    exit 1
fi

DRIVER="$1"
shift

SKIP_LARGE=0
for arg in "$@"; do
    [ "$arg" = "--skip-large" ] && SKIP_LARGE=1
done

# Large files to skip with --skip-large
LARGE_FILES="set.mm set.2010-08-29.mm nf.mm iset.mm ql.mm hol.mm big-unifier.mm set-dist-bad1.mm peano-fixed.mm"

PASSED=0
FAILED=0
SKIPPED=0
TESTS_DIR="tests"

# Test utilities
run() {
    $DRIVER "$TESTS_DIR/$1" >/dev/null 2>&1
}

pass() {
    local file="$1"
    local desc="$2"
    local base=$(basename "$file")

    if [ $SKIP_LARGE -eq 1 ] && echo "$LARGE_FILES" | grep -qw "$base"; then
        echo "SKIP $file (large)"
        ((SKIPPED++))
        return
    fi

    if [ ! -f "$TESTS_DIR/$file" ]; then
        echo "SKIP $file (NOT FOUND)"
        ((SKIPPED++))
        return
    fi

    if run "$file"; then
        echo "PASS $file"
        ((PASSED++))
    else
        echo "FAIL $file (expected ACCEPT) # $desc"
        ((FAILED++))
    fi
}

fail() {
    local file="$1"
    local desc="$2"
    local base=$(basename "$file")

    if [ $SKIP_LARGE -eq 1 ] && echo "$LARGE_FILES" | grep -qw "$base"; then
        echo "SKIP $file (large)"
        ((SKIPPED++))
        return
    fi

    if [ ! -f "$TESTS_DIR/$file" ]; then
        echo "SKIP $file (NOT FOUND)"
        ((SKIPPED++))
        return
    fi

    if ! run "$file"; then
        echo "PASS $file"
        ((PASSED++))
    else
        echo "FAIL $file (expected REJECT) # $desc"
        ((FAILED++))
    fi
}

echo "=========================================="
echo "Metamath Test Suite"
echo "Driver: $DRIVER"
[ $SKIP_LARGE -eq 1 ] && echo "Mode: --skip-large"
echo "=========================================="
