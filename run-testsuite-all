#!/bin/bash
# Run ALL Metamath tests with any driver.
# Usage: ./run-testsuite-all <driver> [--skip-large] [--small-only]
#
# Examples:
#   MM_LEAN4=/path/to/mm-lean4/.lake/build/bin/mm-lean4 ./run-testsuite-all ./test-mm-lean4 --skip-large
#   MM_LEAN4=/path/to/mm-lean4/.lake/build/bin/mm-lean4 ./run-testsuite-all ./test-mm-lean4 --small-only
#   ./run-testsuite-all ./test-metamath-knife
#   MMEXE=/path/to/metamath ./run-testsuite-all ./test-metamath
#
# Tests and expected verdicts are HARDCODED below from the official Metamath
# book (https://us.metamath.org/downloads/metamath.pdf), especially Chapter 4
# and Appendix B.
# This is the authoritative reference - edit HERE to change expectations.

if [ $# -lt 1 ]; then
    echo "Usage: $0 <driver> [--skip-large] [--small-only]"
    echo "Drivers: ./test-mm-lean4, ./test-metamath, ./test-metamath-knife, etc."
    echo ""
    echo "Options:"
    echo "  --skip-large   Skip tests taking 30+ minutes (set.mm, set.2010-08-29.mm)"
    echo "  --small-only   Run only quick tests (< 2 minutes)"
    exit 1
fi

DRIVER="$(realpath "$1")"
shift

SKIP_LARGE=0
SMALL_ONLY=0
for arg in "$@"; do
    [ "$arg" = "--skip-large" ] && SKIP_LARGE=1
    [ "$arg" = "--small-only" ] && SMALL_ONLY=1
done

# Set up output file with timestamp
DRIVER_NAME=$(basename "$DRIVER")
TIMESTAMP=$(date '+%Y%m%d_%H%M%S')
mkdir -p results
OUTPUT_FILE="results/${DRIVER_NAME}_${TIMESTAMP}.log"

# Redirect all output to both stdout and the log file
exec > >(tee "$OUTPUT_FILE") 2>&1

# Small files are in core/small/ directory (< 1000 lines)
# Exception: big-unifier files in core/small/ are included because they're quick and grouped together

PASSED=0
FAILED=0
HARNESS_ERRORS=0
SKIPPED=0
TESTS_DIR="tests"

# Record start time for runtime calculation
START_TIME=$(date +%s)

# Test utilities
run() {
    local test_path="$1"
    local test_dir test_file
    test_dir=$(dirname "$TESTS_DIR/$test_path")
    test_file=$(basename "$test_path")

    # cd to test directory to handle relative includes ($[ ... $])
    (cd "$test_dir" && "$DRIVER" "$test_file" >/dev/null 2>&1)
}

pass() {
    local file="$1"
    local desc="$2"
    local base linecount
    base=$(basename "$file")

    # Check skip conditions for --skip-large: skip files in core/large/
    if [ $SKIP_LARGE -eq 1 ] && [[ "$file" == core/large/* ]]; then
        echo "SKIP $file (large)"
        ((SKIPPED++))
        return
    fi

    # Check skip conditions for --small-only: files < 1000 lines, excluding big-unifier-bad*.mm
    if [ $SMALL_ONLY -eq 1 ]; then
        # Skip big-unifier-bad files (grouped with big-unifier.mm which is >= 1000 lines)
        if [[ "$base" == big-unifier-bad*.mm ]]; then
            echo "SKIP $file (grouped with big-unifier)"
            ((SKIPPED++))
            return
        fi

        # Skip files >= 1000 lines
        linecount=$(wc -l < "$TESTS_DIR/$file" 2>/dev/null || echo "999999")
        if [ "$linecount" -ge 1000 ]; then
            echo "SKIP $file ($linecount lines)"
            ((SKIPPED++))
            return
        fi
    fi

    if [ ! -f "$TESTS_DIR/$file" ]; then
        echo "SKIP $file (NOT FOUND)"
        ((SKIPPED++))
        return
    fi

    local status
    run "$file"
    status=$?
    case "$status" in
        0)
            echo "PASS $file"
            ((PASSED++))
            ;;
        1)
            echo "FAIL $file - verifier rejected but should accept # $desc"
            ((FAILED++))
            ;;
        *)
            echo "HARNESS $file - driver failed with status $status # $desc"
            ((HARNESS_ERRORS++))
            ;;
    esac
}

fail() {
    local file="$1"
    local desc="$2"
    local base linecount
    base=$(basename "$file")

    # Check skip conditions for --skip-large: skip files in core/large/
    if [ $SKIP_LARGE -eq 1 ] && [[ "$file" == core/large/* ]]; then
        echo "SKIP $file (large)"
        ((SKIPPED++))
        return
    fi

    # Check skip conditions for --small-only: files < 1000 lines, excluding big-unifier-bad*.mm
    if [ $SMALL_ONLY -eq 1 ]; then
        # Skip big-unifier-bad files (grouped with big-unifier.mm which is >= 1000 lines)
        if [[ "$base" == big-unifier-bad*.mm ]]; then
            echo "SKIP $file (grouped with big-unifier)"
            ((SKIPPED++))
            return
        fi

        # Skip files >= 1000 lines
        linecount=$(wc -l < "$TESTS_DIR/$file" 2>/dev/null || echo "999999")
        if [ "$linecount" -ge 1000 ]; then
            echo "SKIP $file ($linecount lines)"
            ((SKIPPED++))
            return
        fi
    fi

    if [ ! -f "$TESTS_DIR/$file" ]; then
        echo "SKIP $file (NOT FOUND)"
        ((SKIPPED++))
        return
    fi

    local status
    run "$file"
    status=$?
    case "$status" in
        0)
            echo "FAIL $file - verifier accepted but should reject # $desc"
            ((FAILED++))
            ;;
        1)
            echo "PASS $file"
            ((PASSED++))
            ;;
        *)
            echo "HARNESS $file - driver failed with status $status # $desc"
            ((HARNESS_ERRORS++))
            ;;
    esac
}

echo "=========================================="
echo "Metamath Test Suite"
echo "Driver: $DRIVER"
[ $SKIP_LARGE -eq 1 ] && echo "Mode: --skip-large (excludes 30+ min tests)"
[ $SMALL_ONLY -eq 1 ] && echo "Mode: --small-only (only < 2 min tests)"
echo "Start Time: $(date '+%Y-%m-%d %H:%M:%S')"
echo "=========================================="
