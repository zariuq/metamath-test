#!/bin/sh
# PeTTa pverify Metamath verifier driver
# Takes .mm file as first argument, returns exit code 0 on success
#
# Requires in the same directory as this script:
#   run-pverify.sh  — local wrapper invoking PeTTa with the correct verifier

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MMFILE="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"

ulimit -v 6291456
"$SCRIPT_DIR/run-pverify.sh" "$MMFILE" > /dev/null 2>&1
