#!/bin/sh
# Check mm file "$1" using metamath C implementation.
# Return 0 on acceptance, 1 on semantic rejection, and 2 on harness failure.
# We only report on errors, not on warnings.
#
# Fail-closed: a missing or non-executable binary is a harness error (exit 2),
# never an implicit accept.  metamath-exe exits 0 even after read/verify
# errors, so the verdict comes from grepping the output for '?Error'.

set -u

MMEXE="${MMEXE:-./metamath}"
if [ ! -x "$MMEXE" ] && ! command -v "$MMEXE" >/dev/null 2>&1; then
  echo "MMEXE is not an executable metamath binary: $MMEXE" >&2
  exit 2
fi

LOG="$(mktemp -t mmexe.XXXXXX.log)"
trap 'rm -f "$LOG"' EXIT

"$MMEXE" "read \"$1\"" 'verify proof *' exit >"$LOG" 2>&1
status=$?
if [ "$status" -ne 0 ]; then
  echo "metamath-exe terminated abnormally (status $status)" >&2
  exit 2
fi

if grep -F -q '?Error' "$LOG"; then
  exit 1
fi
exit 0
