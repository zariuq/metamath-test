#!/bin/sh
# Pure Prolog Metamath verifier driver
# Takes .mm file as first argument, returns exit code 0 on success
#
# Requires in the same directory as this script:
#   pverify.pl  — symlink or copy of the Prolog verifier

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MMFILE="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"

ulimit -v 6291456
swipl -g main -t halt "$SCRIPT_DIR/pverify.pl" -- "$MMFILE" > /dev/null 2>&1
